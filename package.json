    "demo": "node --experimental-strip-types --no-warnings src/cli.ts demo",
    "cli": "node --experimental-strip-types --no-warnings src/cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.9.0"
  }
}
