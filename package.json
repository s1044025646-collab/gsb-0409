{
  "name": "trump-trick-backend",
  "version": "1.0.0",
  "description": "四人固定将牌吃墩与必须跟牌核验后端（TypeScript + Node.js + SQLite，API 与 CLI）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "ttb": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types --no-warnings tests/",
